@page
@model RegisterModel
@{
    ViewData["Title"] = "Create account";
}
<div class="pl-auth">
    <div class="pl-auth-card">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="pl-auth-brand">
            <span class="brand-icon"><i class="bi bi-graph-up-arrow"></i></span>
            <span>Plannit</span>
        </a>
        <h1 class="pl-auth-title">Create your account</h1>
        <p class="pl-auth-sub">Track net worth, spending and retirement in one private place.</p>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

        <form id="registerForm" method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>
            <div class="form-floating mb-1">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" aria-describedby="passwordHelp" placeholder="password" />
                <label asp-for="Input.Password">Password</label>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>
            <div id="passwordHelp" class="form-text mb-3">@Model.PasswordRequirements</div>
            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.ConfirmPassword">Confirm password</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>
            <p class="form-text mb-3">By creating an account you agree to the <a asp-controller="Home" asp-action="Terms" target="_blank">Terms of Service</a> and the <a asp-controller="Home" asp-action="Privacy" target="_blank">Privacy Policy</a>.</p>
            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Create account</button>
        </form>

        <p class="pl-auth-footer">
            <span>Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">Sign in</a></span>
            <span class="pl-auth-dot" aria-hidden="true">·</span>
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
            <span class="pl-auth-dot" aria-hidden="true">·</span>
            <a asp-controller="Home" asp-action="Terms">Terms</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
