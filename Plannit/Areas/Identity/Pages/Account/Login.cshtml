@page
@model LoginModel
@using Plannit.Services
@inject IConfiguration Configuration
@inject IEmailSender EmailSender

@{
    ViewData["Title"] = "Sign in";
    var externalLogins = Model.ExternalLogins ?? new List<Microsoft.AspNetCore.Authentication.AuthenticationScheme>();
    var canRegister = RegistrationPolicy.ShowRegistrationLinks(Configuration, EmailSender);
}

<div class="pl-auth">
    <div class="pl-auth-card">
        <a asp-area="" asp-controller="Home" asp-action="Index" class="pl-auth-brand">
            <span class="brand-icon"><i class="bi bi-graph-up-arrow"></i></span>
            <span>Plannit</span>
        </a>
        <h1 class="pl-auth-title">Welcome back</h1>
        <p class="pl-auth-sub">Sign in to your private ledger.</p>

        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

        @if (externalLogins.Count > 0)
        {
            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="pl-auth-providers">
                @foreach (var provider in externalLogins)
                {
                    <button type="submit" class="pl-provider-btn" name="provider" value="@provider.Name"
                            title="Sign in using your @provider.DisplayName account">
                        <i class="bi @ExternalLoginProviders.IconClass(provider.Name)"></i>
                        <span>Continue with @provider.DisplayName</span>
                    </button>
                }
            </form>
            <div class="pl-auth-divider"><span>or sign in with email</span></div>
        }

        <form id="account" method="post">
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email" class="form-label">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.Password" class="form-label">Password</label>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>
            <div class="pl-auth-row">
                <div class="form-check">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label" asp-for="Input.RememberMe">Remember me</label>
                </div>
                <a id="forgot-password" asp-page="./ForgotPassword">Forgot password?</a>
            </div>
            <button id="login-submit" type="submit" class="w-100 btn btn-lg btn-primary">Sign in</button>
        </form>

        <p class="pl-auth-footer">
            @if (canRegister)
            {
                <span>New here? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a></span>
                <span class="pl-auth-dot" aria-hidden="true">·</span>
            }
            <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend confirmation email</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
